<link rel="stylesheet" href="./css/fonts.css" />
<div class="wrap">
  <header>
    <div class="brand"><img src="/favicon.png?v=2" alt=""><h1>mote</h1></div>
    <theme-switch></theme-switch>
  </header>
  <main>
    <file-list kind="viewed"><span slot="title">Recently viewed</span><template webc:nokeep @raw="viewedHtml"></template><p class="empty" data-empty="viewed" hidden>Nothing here yet.</p></file-list>
    <file-list kind="modified"><span slot="title">Recently modified · Notes</span><template webc:nokeep @raw="modifiedHtml"></template><p class="empty" data-empty="modified" hidden>Nothing here yet.</p></file-list>
  </main>
</div>
<style>
  *{box-sizing:border-box}
  body{--bg:#f7f7f5;--text:#242421;--muted:#898985;--line:#e4e3df;margin:0;background:var(--bg);color:var(--text);font:16px/1.5 'Inter',sans-serif}
  body[data-theme="dark"]{--bg:#22262c;--text:#f7f7f7;--muted:#aaa;--line:#42464c}
  .wrap{max-width:980px;margin:auto;padding:48px 24px 64px}
  header{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:4px 0 52px}
  .brand{display:flex;align-items:center;gap:14px}
  header img{width:38px;height:38px}
  h1{font-family:Newsreader,serif;font-size:42px;line-height:1;margin:0;font-style:italic;font-weight:600;letter-spacing:-2px}
  main{display:grid;grid-template-columns:1fr 1fr;gap:40px}
  main>file-list{min-width:0}
  ul{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
  li{border-bottom:1px solid var(--line)}
  li a{display:flex;flex-direction:column;text-decoration:none;color:inherit;padding:13px 2px;min-width:0}
  li a:hover span{color:#9b542a}
  li span,small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  small{font-size:12px;color:var(--muted)}
  .empty{color:var(--muted);font-size:14px}
  @media(max-width:640px){.wrap{padding:30px 18px 44px}header{margin:2px 0 36px}h1{font-size:36px}main{grid-template-columns:1fr;gap:32px}}
</style>
<script>
  let refreshInFlight=false;async function refreshRecentFiles(){if(refreshInFlight)return;refreshInFlight=true;try{const response=await fetch('/api/recent-files',{cache:'no-store'});if(!response.ok)return;const data=await response.json();for(const kind of ['viewed','modified']){const list=document.querySelector('[data-recent-list="'+kind+'"]');const empty=document.querySelector('[data-empty="'+kind+'"]');list.replaceChildren(...data[kind].map(file=>{const li=document.createElement('li');const link=document.createElement('a');link.href=file.url;const name=document.createElement('span');name.textContent=file.title||file.name;const detail=document.createElement('small');detail.textContent=kind==='modified'?file.modifiedLabel:file.path;link.append(name,detail);li.append(link);return li}));empty.hidden=data[kind].length>0}}catch(error){console.error('Could not refresh recent files',error)}finally{refreshInFlight=false}}window.addEventListener('pageshow',refreshRecentFiles);document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible')refreshRecentFiles()});
</script>
