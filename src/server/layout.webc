<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <title webc:keep @raw="title"></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="/favicon.png?v=2">
    <style webc:keep @raw="css"></style>
  </head>
  <body data-theme="light">
    <template webc:nokeep @raw="html"></template>
    <template webc:nokeep @raw="content"></template>
    <script webc:keep @raw="js"></script>
  </body>
</html>
