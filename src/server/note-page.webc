<link rel="stylesheet" href="./css/fonts.css" />
<link rel="stylesheet" href="./css/theme.css" />
<link rel="stylesheet" href="./css/reset.css" />
<link rel="stylesheet" href="./css/notes.css" />
<link rel="stylesheet" href="./css/atom-one-dark.css" />
<link rel="stylesheet" href="./css/mermaid.css" />
<header class="page-header">
  <a class="home-link" href="/" aria-label="Mote home" title="Mote home"><img src="/favicon.png?v=2" alt=""></a>
  <div class="header-actions"><search></search><theme-switch></theme-switch></div>
</header>
<style>
  .page-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    width: 100%;
    padding: 1em;
  }
  .home-link {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
  }
  .home-link img {
    display: block;
    width: 28px;
    height: 28px;
    object-fit: contain;
  }
  .home-link:focus-visible {
    outline: 2px solid var(--highlight-border-color);
    outline-offset: 3px;
  }
  .header-actions { display:flex;align-items:center;gap:2px; }
</style>
<script webc:type="esbuild" src="./live-reload.js"></script>
